{
	"version": 6,
	"cmakeMinimumRequired": {
		"major": 3,
		"minor": 28,
		"patch": 0
	},
	"configurePresets": [
		{
			"name": "windows",
			"displayName": "Windows server (vcpkg)",
			"description": "Visual Studio 2022 x64 build of wivrn-server and the WiVRn OpenXR runtime. Set VCPKG_ROOT to a vcpkg checkout.",
			"generator": "Visual Studio 17 2022",
			"architecture": {
				"value": "x64",
				"strategy": "set"
			},
			"binaryDir": "${sourceDir}/build-windows",
			"cacheVariables": {
				"CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
				"CMAKE_INTERPROCEDURAL_OPTIMIZATION": "ON",
				"CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
				"VCPKG_TARGET_TRIPLET": "x64-windows",
				"X_VCPKG_APPLOCAL_DEPS_INSTALL": "ON",
				"WIVRN_BUILD_CLIENT": "OFF",
				"WIVRN_BUILD_SERVER": "ON",
				"WIVRN_BUILD_SERVER_LIBRARY": "ON",
				"WIVRN_BUILD_TEST": "OFF",
				"WIVRN_USE_NVENC": "ON",
				"WIVRN_USE_VULKAN_ENCODE": "ON",
				"WIVRN_USE_X264": "ON",
				"WIVRN_USE_SYSTEM_BOOST": "ON",
				"WIVRN_FEATURE_SOLARXR": "OFF",
				"WIVRN_FEATURE_STEAMVR_LIGHTHOUSE": "OFF",
				"WIVRN_WERROR": "OFF"
			}
		},
		{
			"name": "windows-ninja",
			"displayName": "Windows server (Ninja, from a VS developer prompt)",
			"inherits": "windows",
			"binaryDir": "${sourceDir}/build-windows-ninja",
			"generator": "Ninja",
			"architecture": {
				"value": "",
				"strategy": "external"
			},
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "RelWithDebInfo"
			}
		}
	],
	"buildPresets": [
		{
			"name": "windows",
			"displayName": "Build Windows server",
			"configurePreset": "windows",
			"configuration": "RelWithDebInfo"
		},
		{
			"name": "windows-ninja",
			"displayName": "Build Windows server (Ninja)",
			"configurePreset": "windows-ninja"
		}
	],
	"packagePresets": [
		{
			"name": "windows",
			"displayName": "Build NSIS installer",
			"configurePreset": "windows",
			"generators": [ "NSIS" ],
			"configurations": [ "RelWithDebInfo" ]
		}
	]
}
